{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "serve": "^14.2.3"
  },
  "scripts": {
    "start": "cross-env HOST=0.0.0.0 PORT=${REACT_APP_PORT:-3000} BROWSER=none react-scripts start",
    "start:ci": "cross-env CI=true REACT_APP_PORT=${REACT_APP_PORT:-3000} npm run build && npm run serve",
    "start:static": "cross-env CI=true REACT_APP_PORT=${REACT_APP_PORT:-3000} npm run build && npm run serve",
    "build": "cross-env CI=true react-scripts build",
    "serve": "serve -s build -l ${REACT_APP_PORT:-3000}",
    "healthcheck": "node -e \"require('http').createServer((req,res)=>{res.end('ok')}).listen(process.env.REACT_APP_PORT||3000,'0.0.0.0')\"",
    "test": "cross-env CI=true react-scripts test --watchAll=false",
    "eject": "react-scripts eject",
    "prepare": "npx --yes update-browserslist-db@latest || true"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "engines": {
    "node": ">=16"
  }
}
